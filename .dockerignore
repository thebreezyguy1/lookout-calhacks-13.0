**/.mypy_cache
**/.ruff_cache
**/*.egg-info

# Node
**/node_modules

# Local data and sandbox API responses
**/*.local.json
**/*.db
**/*.sqlite3
evals/results

# Not needed at runtime
infra
docs
tracks.md
