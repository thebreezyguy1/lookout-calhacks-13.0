# Copy to .env and fill in. Never commit .env.

# Capital One Nessie — key from your profile at http://api.nessieisreal.com/
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com

# CRS Credit API sandbox — credentials from the CRS invite email
CRS_USERNAME=
CRS_PASSWORD=
CRS_BASE_URL=https://api-sandbox.stitchcredit.com:443/api

# LLM for pattern reasoning
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Agent tuning
RISK_WINDOW_HOURS=72
